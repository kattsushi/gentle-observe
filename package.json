{
  "name": "gentle-observe",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tools/*"
    ],
    "catalog": {
      "effect": "4.0.0-rc.108",
      "@effect/platform-bun": "4.0.0-rc.108",
      "@opentui/core": "0.5.2",
      "@opentui/core-linux-x64": "0.5.2",
      "@opentui/solid": "0.5.2",
      "solid-js": "1.9.12"
    },
    "catalogs": {
      "tooling": {
        "bun-types": "1.3.14",
        "nx": "23.1.1",
        "typescript": "7.0.2"
      },
      "quality": {
        "@effect/tsgo": "0.36.4",
        "oxfmt": "0.63.0",
        "oxlint": "1.78.0",
        "oxlint-tsgolint": "7.0.2001"
      }
    }
  },
  "scripts": {
    "affected:check": "nx affected -t format,lint,quality-test",
    "check": "nx run-many -p gentle-observe -t format,lint,quality-test",
    "format": "nx run gentle-observe:format",
    "format:write": "nx run gentle-observe:format-write",
    "graph": "nx show projects",
    "graph:tasks": "nx show project gentle-observe",
    "lint": "nx run gentle-observe:lint",
    "quality:test": "nx run gentle-observe:quality-test"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.4",
    "bun-types": "1.3.14",
    "effect": "4.0.0-rc.108",
    "nx": "23.1.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "nx": {
    "targets": {
      "format": {
        "cache": true,
        "command": "oxfmt --check . --ignore-path .oxfmtignore"
      },
      "format-write": {
        "cache": false,
        "command": "oxfmt . --ignore-path .oxfmtignore"
      },
      "lint": {
        "cache": true,
        "command": "oxlint --no-error-on-unmatched-pattern --type-aware --config .oxlintrc.json ."
      },
      "quality-test": {
        "cache": true,
        "command": "node --test tools/quality/*.test.mjs"
      }
    }
  },
  "trustedDependencies": [
    "nx"
  ]
}
