#!/bin/sh

set -eu

usage() {
  cat <<'EOF'
Usage: scripts/bootstrap [--offline]

Validate the repository-pinned Bun host, install the frozen lockfile, and run
the root Nx quality workflow. Use --offline for a fail-closed no-network
preflight that requires existing node_modules and runs no install or checks.
EOF
}

fail() {
  status=$1
  shift
  printf 'bootstrap: %s\n' "$*" >&2
  exit "$status"
}

offline=false
case "${1:-}" in
  '') ;;
  --offline) offline=true ;;
  --help|-h) usage; exit 0 ;;
  *) usage >&2; fail 64 "unknown option: $1" ;;
esac

case "$(uname -s)" in
  Linux|Darwin) ;;
  *) fail 65 "unsupported operating system: $(uname -s); supported systems are Linux and macOS" ;;
esac

repository_root=$(CDPATH= cd -P "$(dirname "$0")/.." && pwd)
manifest="$repository_root/package.json"
[ -f "$manifest" ] || fail 66 "package.json is required at $repository_root"

expected_bun=$(sed -n 's/^[[:space:]]*"packageManager"[[:space:]]*:[[:space:]]*"bun@\([^"]*\)"[[:space:]]*,*[[:space:]]*$/\1/p' "$manifest")
engine_bun=$(sed -n 's/^[[:space:]]*"bun"[[:space:]]*:[[:space:]]*"\([^"]*\)"[[:space:]]*,*[[:space:]]*$/\1/p' "$manifest")

[ -n "$expected_bun" ] || fail 66 "packageManager must declare an exact bun@VERSION"
[ -n "$engine_bun" ] || fail 66 "engines.bun must declare the packageManager Bun version"
[ "$(printf '%s\n' "$expected_bun" | grep -c '^[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$')" -eq 1 ] || fail 66 "packageManager must declare an exact bun@VERSION"
[ "$(printf '%s\n' "$engine_bun" | grep -c '^[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*$')" -eq 1 ] || fail 66 "engines.bun must declare an exact Bun version"
[ "$expected_bun" = "$engine_bun" ] || fail 66 "packageManager Bun $expected_bun and engines.bun $engine_bun must match"

actual_bun=$(bun --version) || fail 67 "Bun is required; install Bun $expected_bun using your approved host tool"
[ "$actual_bun" = "$expected_bun" ] || fail 67 "Bun $expected_bun is required; found $actual_bun"

cd "$repository_root"
child_pid=

wait_for_child() {
  [ -n "$child_pid" ] || return 0
  wait "$child_pid" 2>/dev/null || true
  child_pid=
}

forward_signal() {
  signal=$1
  [ -n "$child_pid" ] && kill -"$signal" "$child_pid" 2>/dev/null || true
  wait_for_child
  trap - HUP INT TERM
  case "$signal" in
    HUP) exit 129 ;;
    INT) exit 130 ;;
    TERM) exit 143 ;;
  esac
}

trap 'forward_signal HUP' HUP
trap 'forward_signal INT' INT
trap 'forward_signal TERM' TERM

run_child() {
  "$@" &
  child_pid=$!
  wait "$child_pid"
  status=$?
  child_pid=
  return "$status"
}

if "$offline"; then
  # Bun 1.3.14 has no install flag that proves network isolation. A frozen
  # preflight is the only portable fail-closed offline operation. Do not invoke
  # Bun's package manager or the quality subprocesses in this mode.
  [ -d node_modules ] || fail 68 "offline bootstrap requires existing node_modules; run scripts/bootstrap while online first"
  exit 0
else
  if [ -n "${BOOTSTRAP_BUN_CACHE_DIR:-}" ]; then
    run_child bun install --frozen-lockfile --cache-dir "$BOOTSTRAP_BUN_CACHE_DIR"
  else
    run_child bun install --frozen-lockfile
  fi
fi

run_child bun run check
