{
  "name": "app-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "sh scripts/verify-bun.sh && bun run build.ts",
    "typecheck": "sh scripts/verify-bun.sh && tsc --noEmit -p tsconfig.json",
    "test": "sh scripts/verify-bun.sh && bun test test"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@opentui/core": "catalog:",
    "@opentui/core-linux-x64": "catalog:",
    "@opentui/solid": "catalog:",
    "effect": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "bun-types": "catalog:tooling",
    "typescript": "catalog:tooling"
  },
  "nx": {
    "projectType": "application",
    "targets": {
      "test": {
        "cache": true
      },
      "typecheck": {
        "cache": true
      },
      "build": {
        "cache": true,
        "outputs": [
          "{workspaceRoot}/dist/apps/gentle-observe"
        ]
      }
    }
  }
}
