{
  "name": "app-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "sh scripts/verify-bun.sh && bun run build.ts",
    "e2e": "sh scripts/verify-bun.sh && bun test test/e2e.test.ts",
    "typecheck": "sh scripts/verify-bun.sh && tsc --noEmit -p tsconfig.json",
    "test": "sh scripts/verify-bun.sh && bun test test/cli.test.ts test/app.test.tsx test/executable-pty.test.ts"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@opentui/core": "catalog:",
    "@opentui/core-linux-x64": "catalog:",
    "@opentui/react": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-devtools-core": "catalog:",
    "scheduler": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-reconciler": "catalog:",
    "@types/scheduler": "catalog:",
    "@types/ws": "catalog:",
    "bun-types": "catalog:tooling",
    "typescript": "catalog:tooling"
  },
  "nx": {
    "projectType": "application",
    "targets": {
      "test": {
        "cache": true
      },
      "typecheck": {
        "cache": true
      },
      "build": {
        "cache": true,
        "outputs": [
          "{workspaceRoot}/dist/apps/gentle-observe"
        ]
      },
      "e2e": {
        "cache": false,
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
